# Tekaplay configuration template.
#
#   cp .env.example .env
#
# This file is committed and must NEVER contain a real credential. Every
# variable is declared once in backend/app/core/config.py — nothing in the
# application reads os.environ directly, which is what keeps moving between
# providers a configuration change rather than a code change.
#
# Sensitivity legend:
#   [public]  compiled into the browser bundle — assume the world can read it
#   [server]  server-side only, but not itself a credential
#   [SECRET]  a credential. Set it in the platform's secret store, never here.
#
# Production-only rules are enforced at startup by the validator in
# config.py: with APP_ENV=production the app refuses to boot on a default
# SECRET_KEY, a wildcard/non-HTTPS CORS origin, or a localhost database.


# ── Application ────────────────────────────────────────────────
APP_ENV=local                    # [server] local | test | staging | production
APP_NAME=tekaplay
APP_URL=http://localhost:3000    # [server] public web origin; builds links in outgoing emails
API_V1_PREFIX=/api/v1            # [server]
LOG_LEVEL=INFO                   # [server] DEBUG | INFO | WARNING | ERROR

# [SECRET] Signs every access token. Generate with: openssl rand -hex 32
# Rotating it logs everyone out immediately.
SECRET_KEY=change-me-generate-with-openssl-rand-hex-32

# [server] JSON array. Must exactly match the web origin, scheme included.
# Credentialed requests are enabled, so "*" is rejected in production.
CORS_ORIGINS=["http://localhost:3000"]

# [server] Interactive API docs at ${API_V1_PREFIX}/docs. Unset means
# "enabled everywhere except production". Set true to expose them in prod.
# DOCS_ENABLED=false


# ── Database ───────────────────────────────────────────────────
# [SECRET] Contains the password. Neon/Supabase/RDS hand out libpq-style URLs
# with ?sslmode=require — paste them verbatim, app/db/url.py translates them
# for asyncpg (app) and psycopg2 (Alembic) automatically.
#   local:  postgresql+asyncpg://tekaplay:tekaplay@db:5432/tekaplay
#   Neon:   postgresql://user:pw@ep-xxx-pooler.region.aws.neon.tech/tekaplay?sslmode=require
DATABASE_URL=postgresql+asyncpg://tekaplay:tekaplay@db:5432/tekaplay
DATABASE_POOL_SIZE=10            # [server] keep low on serverless Postgres
DATABASE_MAX_OVERFLOW=20         # [server]


# ── Redis (cache, rate limiting, Celery broker) ────────────────
# [SECRET] Upstash issues a rediss:// URL with the token embedded.
# Rate limiting fails OPEN if Redis is unreachable — requests still succeed.
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2


# ── Object storage (S3-compatible) ─────────────────────────────
# Not used yet — there are no file uploads in the application. Left declared
# so adding them later is configuration, not plumbing. Works unchanged with
# Cloudflare R2, AWS S3, MinIO, or Azure Blob via its S3 gateway.
OBJECT_STORAGE_ENDPOINT=          # [server] blank for real AWS S3
OBJECT_STORAGE_BUCKET=tekaplay-assets
OBJECT_STORAGE_ACCESS_KEY=        # [SECRET]
OBJECT_STORAGE_SECRET_KEY=        # [SECRET]
OBJECT_STORAGE_REGION=auto


# ── AI service ─────────────────────────────────────────────────
AI_PROVIDER=echo                  # [server] echo (deterministic, offline) | anthropic
AI_MODEL=claude-sonnet-4-6        # [server]
AI_API_KEY=                       # [SECRET] required when AI_PROVIDER=anthropic
AI_DISPATCH=inline                # [server] inline (no worker) | celery (worker required)
AI_CACHE_TTL_SECONDS=86400
AI_RATE_LIMIT_PER_MINUTE=20


# ── Commerce (Stripe) ──────────────────────────────────────────
# Price IDs are NOT env vars — they live on Plan rows, so pricing changes
# never need a deploy. See docs/DEPLOYMENT.md.
PAYMENT_PROVIDER=fake             # [server] fake (no network) | stripe
STRIPE_API_KEY=                   # [SECRET] sk_live_… — backend only, never the browser
STRIPE_WEBHOOK_SECRET=            # [SECRET] whsec_… — required when provider=stripe
STRIPE_WEBHOOK_TOLERANCE_SECONDS=300


# ── Free trials ────────────────────────────────────────────────
TRIAL_ENABLED=true
TRIAL_DURATION_DAYS=14


# ── Email (invitations, verification, password reset) ──────────
# WARNING: with `console`, these emails are only written to the logs and are
# never delivered. Nobody can reset a password or accept an invitation by
# email until this is switched to `smtp`.
EMAIL_PROVIDER=console            # [server] console (logs only) | smtp
EMAIL_DISPATCH=inline             # [server] inline | celery (worker required)
SMTP_HOST=                        # [server] e.g. smtp.resend.com
SMTP_PORT=587
SMTP_USERNAME=                    # [server]
SMTP_PASSWORD=                    # [SECRET]
FROM_EMAIL=no-reply@tekaplay.app  # [server] must be a domain you have verified


# ── Auth ───────────────────────────────────────────────────────
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=30
AUTH_RATE_LIMIT_ATTEMPTS=10       # [server] login/register/reset attempts per window
AUTH_RATE_LIMIT_WINDOW_SECONDS=900

# [server] Read by uvicorn, not by the application. Behind a reverse proxy
# (Render, an ALB, Front Door) set this to the proxy's address, or "*" when the
# container is ONLY reachable through that proxy. Without it every request
# looks like it came from the proxy, so per-IP rate limits and audit-log IPs
# are wrong. Leave unset when running the port directly — otherwise a client
# can spoof X-Forwarded-For and bypass rate limiting.
# FORWARDED_ALLOW_IPS=*
GOOGLE_OAUTH_CLIENT_ID=           # [public]
GOOGLE_OAUTH_CLIENT_SECRET=       # [SECRET]
MICROSOFT_OAUTH_CLIENT_ID=        # [public]
MICROSOFT_OAUTH_CLIENT_SECRET=    # [SECRET]


# ── Frontend ───────────────────────────────────────────────────
# [public] Inlined into the JavaScript bundle at BUILD time. On Render it must
# be set as a Docker build argument; changing it requires a rebuild, not a
# restart. Never put a secret in a NEXT_PUBLIC_ variable.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000/api/v1
